<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:Shell.Models"
                    xmlns:vision="clr-namespace:Shell.Models.Nodes.Vision"
                    xmlns:motion="clr-namespace:Shell.Models.Nodes.Motion"
                    xmlns:views="clr-namespace:Shell.Views"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:ctrl="clr-namespace:Core.UI.Controls;assembly=Core.UI">

    <!-- ══════════════════════════════════════ -->
    <!--  节点编辑模板选择器 (弹窗用)             -->
    <!-- ══════════════════════════════════════ -->

    <!-- ── 布尔→可见性转换器 ── -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- ── 绑定切换按钮样式 ── -->
    <Style x:Key="BindingToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#20FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ToolTip" Value="绑定到变量"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="4"
                            BorderBrush="Transparent"
                            BorderThickness="1">
                        <TextBlock x:Name="Icon"
                                   Text="&#xf0c1;"
                                   FontFamily="{StaticResource FontAwesome}"
                                   FontSize="12"
                                   Foreground="#888"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Icon" Property="Foreground" Value="#42A5F5"/>
                            <Setter TargetName="Bd" Property="Background" Value="#2042A5F5"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4042A5F5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#3042A5F5"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 通用属性编辑器选择器（独立资源，被 GenericEditTemplate 引用） ── -->
    <views:PropertyEditorSelector x:Key="PropertyEditorSelector">
        <views:PropertyEditorSelector.NumberTemplate>
            <DataTemplate DataType="{x:Type models:PropertyItem}">
                <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- 属性名 + 范围提示 + 绑定切换按钮 -->
                        <DockPanel Margin="0,0,0,6">
                            <ToggleButton DockPanel.Dock="Right"
                                          Style="{StaticResource BindingToggleButtonStyle}"
                                          Visibility="{Binding BindableToVariable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          IsChecked="{Binding Binding.IsBound, Mode=TwoWay}"
                                          ToolTip="绑定到变量"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#888"/>
                                <TextBlock Text="{Binding RangeHint}" FontSize="9" Foreground="#5A8EC0"
                                           Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RangeHint}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <!-- 正常编辑器 -->
                        <ctrl:NumericTextBox x:Name="NormalEditor"
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 NumberKind="{Binding NumericKind}"
                                 PMinValue="{Binding MinValue}"
                                 PMaxValue="{Binding MaxValue}"
                                 EnableKeypad="False"
                                 ToolTip="{Binding RangeHint}"
                                 Width="120" FontSize="18" FontWeight="Bold"
                                 Foreground="#90CAF9" HorizontalContentAlignment="Center"
                                 Background="#FF2A2A3C" BorderBrush="#FF3F3F58"/>
                        <!-- 变量绑定下拉框 -->
                        <hc:ComboBox x:Name="BindingEditor" Width="220"
                                  ItemsSource="{Binding VariableNames}"
                                  SelectedItem="{Binding Binding.BoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Binding.IsBound}" Value="True">
                        <Setter TargetName="NormalEditor" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="BindingEditor" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </views:PropertyEditorSelector.NumberTemplate>
        <views:PropertyEditorSelector.BooleanTemplate>
            <DataTemplate DataType="{x:Type models:PropertyItem}">
                <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- 绑定切换按钮 -->
                        <DockPanel Margin="0,0,0,4" Visibility="{Binding BindableToVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ToggleButton DockPanel.Dock="Right"
                                          Style="{StaticResource BindingToggleButtonStyle}"
                                          IsChecked="{Binding Binding.IsBound, Mode=TwoWay}"
                                          ToolTip="绑定到变量"/>
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#888"/>
                        </DockPanel>
                        <!-- 正常编辑器 -->
                        <CheckBox x:Name="NormalEditor" Content="{Binding Name}" IsChecked="{Binding BoolValue}"
                                  Foreground="#A5D6A7" FontSize="13"/>
                        <!-- 变量绑定下拉框 -->
                        <hc:ComboBox x:Name="BindingEditor" Width="220"
                                  ItemsSource="{Binding VariableNames}"
                                  SelectedItem="{Binding Binding.BoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Binding.IsBound}" Value="True">
                        <Setter TargetName="NormalEditor" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="BindingEditor" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </views:PropertyEditorSelector.BooleanTemplate>
        <views:PropertyEditorSelector.EnumTemplate>
            <DataTemplate DataType="{x:Type models:PropertyItem}">
                <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- 属性名 + 绑定切换按钮 -->
                        <DockPanel Margin="0,0,0,6">
                            <ToggleButton DockPanel.Dock="Right"
                                          Style="{StaticResource BindingToggleButtonStyle}"
                                          Visibility="{Binding BindableToVariable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          IsChecked="{Binding Binding.IsBound, Mode=TwoWay}"
                                          ToolTip="绑定到变量"/>
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#888"/>
                        </DockPanel>
                        <!-- 正常编辑器 -->
                        <hc:ComboBox x:Name="NormalEditor" Width="220"
                                  ItemsSource="{Binding EnumOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding EnumIndex, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- 变量绑定下拉框 -->
                        <hc:ComboBox x:Name="BindingEditor" Width="220"
                                  ItemsSource="{Binding VariableNames}"
                                  SelectedItem="{Binding Binding.BoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Binding.IsBound}" Value="True">
                        <Setter TargetName="NormalEditor" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="BindingEditor" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </views:PropertyEditorSelector.EnumTemplate>
        <views:PropertyEditorSelector.TextTemplate>
            <DataTemplate DataType="{x:Type models:PropertyItem}">
                <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- 属性名 + 绑定切换按钮 -->
                        <DockPanel Margin="0,0,0,6">
                            <ToggleButton DockPanel.Dock="Right"
                                          Style="{StaticResource BindingToggleButtonStyle}"
                                          Visibility="{Binding BindableToVariable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          IsChecked="{Binding Binding.IsBound, Mode=TwoWay}"
                                          ToolTip="绑定到变量"/>
                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#888"/>
                        </DockPanel>
                        <!-- 正常编辑器 -->
                        <hc:TextBox x:Name="NormalEditor"
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Foreground="#B0BEC5"
                                 Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                 Padding="10,6"/>
                        <!-- 变量绑定下拉框 -->
                        <hc:ComboBox x:Name="BindingEditor" Width="220"
                                  ItemsSource="{Binding VariableNames}"
                                  SelectedItem="{Binding Binding.BoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Binding.IsBound}" Value="True">
                        <Setter TargetName="NormalEditor" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="BindingEditor" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </views:PropertyEditorSelector.TextTemplate>
    </views:PropertyEditorSelector>

    <views:NodeEditTemplateSelector x:Key="EditTemplateSelector">

        <!-- ═══ 常量节点 ═══ -->
        <views:NodeEditTemplateSelector.ConstantEditTemplate>
            <DataTemplate DataType="{x:Type models:ConstantNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 常量值设定" FontWeight="Bold" FontSize="15"
                               Foreground="#2E7D32" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="值类型" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="220" SelectedValuePath="Tag"
                                      SelectedValue="{Binding ConstantTypeTag, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="Double" Content="🔢 数值 (double)"/>
                                <ComboBoxItem Tag="Int32" Content="🔹 整数 (int)"/>
                                <ComboBoxItem Tag="Boolean" Content="✅ 布尔 (bool)"/>
                                <ComboBoxItem Tag="String" Content="📝 字符串 (string)"/>
                            </hc:ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="值" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ConstantString, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="18" FontWeight="Bold"
                                     Foreground="#66BB6A" CaretBrush="#66BB6A"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     BorderThickness="1" Padding="10,8"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.ConstantEditTemplate>

        <!-- ═══ 函数节点 ═══ -->
        <views:NodeEditTemplateSelector.FunctionEditTemplate>
            <DataTemplate DataType="{x:Type models:FunctionNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 函数设定" FontWeight="Bold" FontSize="15"
                               Foreground="#42A5F5" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="运算方式" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="220" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Op, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="Add" Content="➕ 加法 (A + B)"/>
                                <ComboBoxItem Tag="Subtract" Content="➖ 减法 (A − B)"/>
                                <ComboBoxItem Tag="Multiply" Content="✖ 乘法 (A × B)"/>
                                <ComboBoxItem Tag="Divide" Content="➗ 除法 (A ÷ B)"/>
                            </hc:ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1A2744" CornerRadius="8" Padding="16,12"
                            BorderBrush="#FF2E5090" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="表达式预览" FontSize="10" Foreground="#5A8EC0"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Expression, Mode=OneWay}"
                                       FontSize="20" FontFamily="Consolas"
                                       Foreground="#FF6DB3F2" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.FunctionEditTemplate>

        <!-- ═══ 显示节点 ═══ -->
        <views:NodeEditTemplateSelector.DisplayEditTemplate>
            <DataTemplate DataType="{x:Type models:DisplayNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 显示节点设定" FontWeight="Bold" FontSize="15"
                               Foreground="#FFA726" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="标题" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#FFCC80"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF2E1F10" CornerRadius="8" Padding="16,12"
                            BorderBrush="#FF5D4037" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="当前值" FontSize="10" Foreground="#BF6E3A"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DisplayText, Mode=OneWay}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#FFFFA726" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.DisplayEditTemplate>

        <!-- ═══ 延时节点 ═══ -->
        <views:NodeEditTemplateSelector.DelayEditTemplate>
            <DataTemplate DataType="{x:Type models:DelayNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 延时设定" FontWeight="Bold" FontSize="15"
                               Foreground="#26A69A" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="延时时间" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ctrl:NumericTextBox Grid.Column="0"
                                         Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}"
                                         NumberKind="Int" EnableKeypad="False"
                                         PMinValue="0" PMaxValue="600000"
                                         ToolTip="范围: 0 ~ 600,000 ms"
                                         Width="90" FontSize="18" FontWeight="Bold"
                                         Foreground="#80CBC4"
                                         Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                         HorizontalContentAlignment="Center"
                                         Style="{StaticResource DialogTextBox}"/>
                                <TextBlock Grid.Column="1" Text=" ms" FontSize="14"
                                           Foreground="#4DB6AC"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.DelayEditTemplate>

        <!-- ═══ 判断节点 ═══ -->
        <views:NodeEditTemplateSelector.ConditionEditTemplate>
            <DataTemplate DataType="{x:Type models:ConditionNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 判断条件设定" FontWeight="Bold" FontSize="15"
                               Foreground="#AB47BC" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="比较方式" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="220"
                                      ItemsSource="{x:Static models:ConditionNodeViewModel.AvailableCompareOps}"
                                      DisplayMemberPath="Symbol"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Operation, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="阈值" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="-1000000" PMaxValue="1000000"
                                     ToolTip="范围: -1,000,000 ~ 1,000,000"
                                     Width="120" FontSize="18" FontWeight="Bold"
                                     Foreground="#CE93D8"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     HorizontalContentAlignment="Center"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.ConditionEditTemplate>

        <!-- ═══ 循环节点 ═══ -->
        <views:NodeEditTemplateSelector.LoopEditTemplate>
            <DataTemplate DataType="{x:Type models:LoopNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 循环设定" FontWeight="Bold" FontSize="15"
                               Foreground="#EF5350" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="循环次数" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ctrl:NumericTextBox Grid.Column="0"
                                         Text="{Binding LoopCount, UpdateSourceTrigger=PropertyChanged}"
                                         NumberKind="Int" EnableKeypad="False"
                                         PMinValue="1" PMaxValue="10000"
                                         ToolTip="范围: 1 ~ 10,000"
                                         Width="90" FontSize="18" FontWeight="Bold"
                                         Foreground="#EF9A9A"
                                         Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                         HorizontalContentAlignment="Center"
                                         Style="{StaticResource DialogTextBox}"/>
                                <TextBlock Grid.Column="1" Text=" 次" FontSize="14"
                                           Foreground="#E57373"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.LoopEditTemplate>

        <!-- ═══ 图像源节点 ═══ -->
        <views:NodeEditTemplateSelector.ImageSourceEditTemplate>
            <DataTemplate DataType="{x:Type vision:ImageSourceNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 图像源设定" FontWeight="Bold" FontSize="15"
                               Foreground="#26C6DA" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="图片路径" FontSize="11" Foreground="#888" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FilePath, Mode=OneWay}"
                                         FontSize="12" Foreground="#80DEEA"
                                         Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                         Padding="8,6" Style="{StaticResource DialogTextBox}"
                                         VerticalAlignment="Center" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="📂 浏览..."
                                        Width="70" Height="30" Margin="8,0,0,0"
                                        Command="{Binding BrowseImageCommand}"
                                        Background="#FF2E5090" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1A2E3E" CornerRadius="8" Padding="14,10"
                            BorderBrush="#FF2E7090" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="文件信息" FontSize="10" Foreground="#4FC3F7" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding FileName, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#4DD0E1"/>
                            <TextBlock Text="{Binding ImageInfo, Mode=OneWay}"
                                       FontSize="11" Foreground="#80DEEA" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.ImageSourceEditTemplate>

        <!-- ═══ 高斯模糊节点 ═══ -->
        <views:NodeEditTemplateSelector.GaussianBlurEditTemplate>
            <DataTemplate DataType="{x:Type vision:GaussianBlurNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 高斯模糊设定" FontWeight="Bold" FontSize="15"
                               Foreground="#7E57C2" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="核大小 (奇数)" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding KernelSize, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Int" EnableKeypad="False"
                                     PMinValue="3" PMaxValue="31"
                                     ToolTip="范围: 3 ~ 31（仅奇数有效）"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#B39DDB" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Sigma X" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding SigmaX, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0.1" PMaxValue="50"
                                     ToolTip="范围: 0.1 ~ 50"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#B39DDB" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.GaussianBlurEditTemplate>

        <!-- ═══ 色彩转换节点 ═══ -->
        <views:NodeEditTemplateSelector.CvtColorEditTemplate>
            <DataTemplate DataType="{x:Type vision:CvtColorNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 色彩转换设定" FontWeight="Bold" FontSize="15"
                               Foreground="#FF7043" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="转换类型" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="220" SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedIndex, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="0">🌑 灰度 (BGR→GRAY)</ComboBoxItem>
                                <ComboBoxItem Tag="1">🎨 HSV (BGR→HSV)</ComboBoxItem>
                                <ComboBoxItem Tag="2">🔬 Lab (BGR→Lab)</ComboBoxItem>
                            </hc:ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.CvtColorEditTemplate>

        <!-- ═══ 二值化节点 ═══ -->
        <views:NodeEditTemplateSelector.ThresholdEditTemplate>
            <DataTemplate DataType="{x:Type vision:ThresholdNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 二值化设定" FontWeight="Bold" FontSize="15"
                               Foreground="#78909C" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="阈值类型" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="220" SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedTypeIndex, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="0">⬛ Binary</ComboBoxItem>
                                <ComboBoxItem Tag="1">⬜ BinaryInv</ComboBoxItem>
                                <ComboBoxItem Tag="2">📊 Otsu</ComboBoxItem>
                            </hc:ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="阈值" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding ThresholdValue, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0" PMaxValue="255"
                                     ToolTip="范围: 0 ~ 255"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#B0BEC5" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="最大值" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0" PMaxValue="255"
                                     ToolTip="范围: 0 ~ 255"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#B0BEC5" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.ThresholdEditTemplate>

        <!-- ═══ 缩放节点 ═══ -->
        <views:NodeEditTemplateSelector.ResizeEditTemplate>
            <DataTemplate DataType="{x:Type vision:ResizeNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 缩放设定" FontWeight="Bold" FontSize="15"
                               Foreground="#66BB6A" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="缩放模式" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <CheckBox Content="比例缩放 (ScaleMode)" IsChecked="{Binding UseScaleMode}"
                                      Foreground="#A5D6A7" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="X 缩放比例" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0.01" PMaxValue="10"
                                     ToolTip="范围: 0.01 ~ 10"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#81C784" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Y 缩放比例" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0.01" PMaxValue="10"
                                     ToolTip="范围: 0.01 ~ 10"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#81C784" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.ResizeEditTemplate>

        <!-- ═══ Canny 边缘检测节点 ═══ -->
        <views:NodeEditTemplateSelector.CannyEdgeEditTemplate>
            <DataTemplate DataType="{x:Type vision:CannyEdgeNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ Canny 边缘设定" FontWeight="Bold" FontSize="15"
                               Foreground="#FFA726" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="低阈值" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding Threshold1, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0" PMaxValue="500"
                                     ToolTip="范围: 0 ~ 500"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#FFCC80" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="高阈值" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding Threshold2, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Float" EnableKeypad="False"
                                     PMinValue="0" PMaxValue="500"
                                     ToolTip="范围: 0 ~ 500"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#FFCC80" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.CannyEdgeEditTemplate>

        <!-- ═══ 形态学节点 ═══ -->
        <views:NodeEditTemplateSelector.MorphologyEditTemplate>
            <DataTemplate DataType="{x:Type vision:MorphologyNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 形态学设定" FontWeight="Bold" FontSize="15"
                               Foreground="#26C6DA" Margin="0,0,0,15"/>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="操作类型" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="220" SelectedValuePath="Tag"
                                      SelectedValue="{Binding SelectedOpIndex, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Tag="0">🔲 膨胀 (Dilate)</ComboBoxItem>
                                <ComboBoxItem Tag="1">🔳 腐蚀 (Erode)</ComboBoxItem>
                                <ComboBoxItem Tag="2">⭕ 开运算 (Open)</ComboBoxItem>
                                <ComboBoxItem Tag="3">⭕ 闭运算 (Close)</ComboBoxItem>
                            </hc:ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="核大小" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding KernelSize, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Int" EnableKeypad="False"
                                     PMinValue="3" PMaxValue="31"
                                     ToolTip="范围: 3 ~ 31（仅奇数有效）"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#80DEEA" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="迭代次数" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <ctrl:NumericTextBox Text="{Binding Iterations, UpdateSourceTrigger=PropertyChanged}"
                                     NumberKind="Int" EnableKeypad="False"
                                     PMinValue="1" PMaxValue="20"
                                     ToolTip="范围: 1 ~ 20"
                                     Width="100" FontSize="18" FontWeight="Bold"
                                     Foreground="#80DEEA" HorizontalContentAlignment="Center"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.MorphologyEditTemplate>

        <!-- ═══ 图像显示节点 ═══ -->
        <views:NodeEditTemplateSelector.ImageDisplayEditTemplate>
            <DataTemplate DataType="{x:Type vision:ImageDisplayNodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 图像显示设定" FontWeight="Bold" FontSize="15"
                               Foreground="#26C6DA" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="标题" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#80DEEA"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF1A2E3E" CornerRadius="8" Padding="14,10"
                            BorderBrush="#FF2E7090" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="图像信息" FontSize="10" Foreground="#4FC3F7" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ImageInfo, Mode=OneWay}"
                                       FontSize="12" Foreground="#4DD0E1"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.ImageDisplayEditTemplate>

        <!-- ═══ 多轴定位节点（DataGrid 编辑） ═══ -->
        <views:NodeEditTemplateSelector.MultiAxisMoveEditTemplate>
            <DataTemplate DataType="{x:Type motion:MultiAxisMoveNodeViewModel}">
                <StackPanel Margin="16,12">
                    <TextBlock FontWeight="Bold" FontSize="15"
                               Foreground="#FFA726" Margin="4,0,0,10">
                        <Run Text="⚙ "/><Run Text="{Binding Title, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 节点名称 -->
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="节点名称" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#FFCC80"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- 定位方式下拉 -->
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="定位方式" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <hc:ComboBox Width="160" SelectedIndex="{Binding MoveType, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem>绝对定位</ComboBoxItem>
                                <ComboBoxItem>相对定位</ComboBoxItem>
                            </hc:ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- 轴配置 DataGrid -->
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="轴运动配置" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#C0C0D0" VerticalAlignment="Center"/>
                                <Button Content="+ 添加行" HorizontalAlignment="Right"
                                        Width="70" Height="24" FontSize="11"
                                        Background="#FF2E7D32" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Command="{Binding AddAxisCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding AxisConfigs}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      Background="#FF2A2A3C"
                                      Foreground="#E0E0E0"
                                      BorderBrush="#FF3F3F58"
                                      RowBackground="#FF2A2A3C"
                                      AlternatingRowBackground="#FF2F2F42"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#FF3F3F58"
                                      SelectionUnit="Cell"
                                      MinHeight="80" MaxHeight="260"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="轴 ID" Width="60"
                                                        Binding="{Binding AxisId, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#90CAF9"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#FF1E1E2E"/>
                                                <Setter Property="BorderBrush" Value="#FF42A5F5"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="速度 (mm/s)" Width="90"
                                                        Binding="{Binding Speed, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A5D6A7"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#FF1E1E2E"/>
                                                <Setter Property="BorderBrush" Value="#FF42A5F5"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="位置 (mm)" Width="90"
                                                        Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFCC80"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="#FF1E1E2E"/>
                                                <Setter Property="BorderBrush" Value="#FF42A5F5"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Width="24" Height="20"
                                                        Background="Transparent"
                                                        Foreground="#EF5350"
                                                        BorderThickness="0" Cursor="Hand"
                                                        FontSize="12"
                                                        Command="{Binding DataContext.RemoveAxisCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.MultiAxisMoveEditTemplate>

        <!-- ═══ 等待信号节点 ═══ -->
        <views:NodeEditTemplateSelector.AwaitInputEditTemplate>
            <DataTemplate DataType="{x:Type motion:AwaitInPutNodeViewModel}">
                <StackPanel Margin="16,12">
                    <TextBlock FontWeight="Bold" FontSize="15"
                               Foreground="#66BB6A" Margin="4,0,0,10">
                        <Run Text="⚙ "/><Run Text="{Binding Title, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 节点名称 -->
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="节点名称" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#90CAF9"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- 信号配置列表 -->
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Content="＋ 添加信号"
                                        Command="{Binding AddSignalCommand}"
                                        Width="90" Height="28"
                                        Background="#FF1565C0" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        FontSize="11" Margin="0,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF1E88E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="📡 信号配置" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#90A4AE"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding SignalConfigs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type motion:SignalConfig}">
                                        <Border Background="#FF252535" CornerRadius="6"
                                                Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 信号选择 -->
                                                <hc:ComboBox Grid.Column="0"
                                                             ItemsSource="{Binding FilteredSignals}"
                                                             DisplayMemberPath="Name"
                                                             SelectedItem="{Binding SelectedSignal, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,0,6,0"
                                                             HorizontalContentAlignment="Center"
                                                             IsSynchronizedWithCurrentItem="False"/>

                                                <!-- 判断条件 -->
                                                <hc:ComboBox Grid.Column="1"
                                                             SelectedIndex="{Binding Condition, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="3,0"
                                                             HorizontalContentAlignment="Center">
                                                    <ComboBoxItem Content="低电平" HorizontalContentAlignment="Center"/>
                                                    <ComboBoxItem Content="高电平" HorizontalContentAlignment="Center"/>
                                                </hc:ComboBox>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Width="22" Height="22"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        Foreground="#EF5350"
                                                        BorderThickness="0" Cursor="Hand"
                                                        FontSize="11"
                                                        ToolTip="移除该信号"
                                                        Command="{Binding DataContext.RemoveSignalCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#33EF5350"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.AwaitInputEditTemplate>

        <!-- ═══ 输出信号节点 ═══ -->
        <views:NodeEditTemplateSelector.OutputSignalEditTemplate>
            <DataTemplate DataType="{x:Type motion:OutputSignalNodeViewModel}">
                <StackPanel Margin="16,12">
                    <TextBlock FontWeight="Bold" FontSize="15"
                               Foreground="#FFB74D" Margin="4,0,0,10">
                        <Run Text="⚙ "/><Run Text="{Binding Title, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 节点名称 -->
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="节点名称" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#90CAF9"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- 输出信号配置列表 -->
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Content="＋ 添加信号"
                                        Command="{Binding AddSignalCommand}"
                                        Width="90" Height="28"
                                        Background="#FF1565C0" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        FontSize="11" Margin="0,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF1E88E5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="🔌 输出信号配置" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#90A4AE"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding SignalConfigs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type motion:OutputSignalConfig}">
                                        <Border Background="#FF252535" CornerRadius="6"
                                                Padding="8,6" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 信号选择 -->
                                                <hc:ComboBox Grid.Column="0"
                                                             ItemsSource="{Binding FilteredSignals}"
                                                             DisplayMemberPath="Name"
                                                             SelectedItem="{Binding SelectedSignal, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0,0,6,0"
                                                             HorizontalContentAlignment="Center"
                                                             IsSynchronizedWithCurrentItem="False"/>

                                                <!-- 目标状态 -->
                                                <hc:ComboBox Grid.Column="1"
                                                             SelectedIndex="{Binding TargetState, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="3,0"
                                                             HorizontalContentAlignment="Center">
                                                    <ComboBoxItem Content="OFF" HorizontalContentAlignment="Center"/>
                                                    <ComboBoxItem Content="ON" HorizontalContentAlignment="Center"/>
                                                </hc:ComboBox>

                                                <!-- 删除按钮 -->
                                                <Button Grid.Column="2"
                                                        Content="✕"
                                                        Width="22" Height="22"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        Foreground="#EF5350"
                                                        BorderThickness="0" Cursor="Hand"
                                                        FontSize="11"
                                                        ToolTip="移除该信号"
                                                        Command="{Binding DataContext.RemoveSignalCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#33EF5350"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 操作说明 -->
                            <TextBlock Text="触发后一次性写入全部信号，结果输出是否全部成功。"
                                       FontSize="10" Foreground="#607D8B"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.OutputSignalEditTemplate>

        <!-- ═══ 通用编辑模板（分组折叠 + 滚动，反射 [NodeProperty] 自动生成） ═══ -->
        <views:NodeEditTemplateSelector.GenericEditTemplate>
            <DataTemplate DataType="{x:Type models:NodeViewModel}">
                <StackPanel Margin="16,12">
                    <!-- 标题 -->
                    <TextBlock FontWeight="Bold" FontSize="15"
                               Foreground="#42A5F5" Margin="4,0,0,10">
                        <Run Text="⚙ "/><Run Text="{Binding Title, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 节点名称 -->
                    <Border Background="{DynamicResource EditorCardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="节点名称" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#90CAF9"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- 属性分组列表 -->
                    <ItemsControl ItemsSource="{Binding PropertyGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PropertyGroup}">
                                <Border Background="#FF1E1E2E" CornerRadius="6" Margin="0,0,0,8" Padding="0">
                                    <StackPanel>
                                        <!-- 分组标题（有 Group 名时才显示，可点击折叠） -->
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Background="#FF252535"
                                                      BorderThickness="0"
                                                      Cursor="Hand"
                                                      HorizontalContentAlignment="Left"
                                                      Visibility="{Binding HasName, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6,6,0,0" Padding="10,7">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding ExpandIcon}" FontSize="10"
                                                                       Foreground="#888" Width="16"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#C0C0D0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <!-- 分组内容 -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      ItemTemplateSelector="{StaticResource PropertyEditorSelector}"
                                                      Margin="10,8"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ═══ 输出变量绑定 ═══ -->
                    <Border Background="#FF1E2E1E" CornerRadius="6" Margin="0,8,0,8" Padding="0">
                        <StackPanel>
                            <Border Background="#FF2E352E" CornerRadius="6,6,0,0" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗" FontSize="12" Foreground="#81C784" Width="20"/>
                                    <TextBlock Text="输出绑定" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#C0D0C0"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding OutputBindings}" Margin="10,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OutputBindingInfo}">
                                        <Border Background="#FF252535" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <ToggleButton DockPanel.Dock="Right"
                                                                  Style="{StaticResource BindingToggleButtonStyle}"
                                                                  IsChecked="{Binding IsBound, Mode=TwoWay}"
                                                                  ToolTip="将输出值写入变量"/>
                                                    <TextBlock FontSize="11" Foreground="#A5D6A7" VerticalAlignment="Center">
                                                        <Run Text="输出 "/>
                                                        <Run Text="{Binding ConnectorTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </DockPanel>
                                                <hc:ComboBox ItemsSource="{Binding AvailableVariables}"
                                                          SelectedItem="{Binding BoundVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsBound, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          Width="220"
                                                          Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 无参数提示 -->
                    <Border Background="#FF1A2530" CornerRadius="6" Padding="12,10"
                            Visibility="{Binding PropertyGroups.Count, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="此节点无额外可配置参数。"
                                   Foreground="#607D8B" FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.GenericEditTemplate>

        <!-- ═══ 默认模板 ═══ -->
        <views:NodeEditTemplateSelector.DefaultEditTemplate>
            <DataTemplate DataType="{x:Type models:NodeViewModel}">
                <StackPanel Margin="20,15">
                    <TextBlock Text="⚙ 节点设定" FontWeight="Bold" FontSize="15"
                               Foreground="#78909C" Margin="0,0,0,15"/>
                    <Border Background="#FF1E1E2E" CornerRadius="6" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="标题" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Foreground="#B0BEC5"
                                     Background="#FF2A2A3C" BorderBrush="#FF3F3F58"
                                     Padding="10,6" Style="{StaticResource DialogTextBox}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,20,0,0" Text="此节点类型暂无专用编辑器。"
                               Foreground="#607D8B" FontSize="12" FontStyle="Italic"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
        </views:NodeEditTemplateSelector.DefaultEditTemplate>

    </views:NodeEditTemplateSelector>

</ResourceDictionary>
