<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:Shell.Models"
                    xmlns:vision="clr-namespace:Shell.Models.Nodes.Vision"
                    xmlns:motion="clr-namespace:Shell.Models.Nodes.Motion"
                    xmlns:views="clr-namespace:Shell.Views"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
                    xmlns:shared="clr-namespace:Nodify;assembly=Nodify.Shared">

    <!-- ══════════════════════════════════════ -->
    <!--  节点渲染模板选择器 (编辑器用)           -->
    <!-- ══════════════════════════════════════ -->

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <shared:StringToBrushConverter x:Key="StringToBrushConverter" />

    <!-- ═══ 节点头部模板（Path 矢量状态图标） ═══ -->
    <DataTemplate x:Key="NodeHeaderTemplate" DataType="{x:Type models:NodeViewModel}">
        <StackPanel Orientation="Horizontal">
            <!-- 状态图标 14x14 Viewbox -->
            <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                <Grid Width="14" Height="14">
                    <!-- ✓ 成功：绿底白色对勾 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Success">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Path Data="M7,1 A6,6 0 1,0 7,13 A6,6 0 1,0 7,1 Z" Fill="#4CAF50"/>
                        <Path Data="M3.5,7 L6,9.5 L10.5,4" Stroke="White" StrokeThickness="1.6"
                              StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                    </Grid>
                    <!-- ✗ 失败：红底白色叉号 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Path Data="M7,1 A6,6 0 1,0 7,13 A6,6 0 1,0 7,1 Z" Fill="#EF5350"/>
                        <Path Data="M4.5,4.5 L9.5,9.5 M9.5,4.5 L4.5,9.5" Stroke="White" StrokeThickness="1.5"
                              StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Fill="Transparent"/>
                    </Grid>
                    <!-- ◎ 运行中：蓝色填充圆 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Path Data="M7,1.5 A5.5,5.5 0 1,0 7,12.5 A5.5,5.5 0 1,0 7,1.5 Z" Fill="#42A5F5"/>
                    </Grid>
                </Grid>
            </Viewbox>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

    <views:NodeTemplateSelector x:Key="NodeTemplateSelector">

        <!-- ── 常量节点 ── -->
        <views:NodeTemplateSelector.ConstantTemplate>
            <DataTemplate DataType="{x:Type models:ConstantNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FF66BB6A" BorderThickness="1.5"
                             HeaderBrush="{StaticResource GreenHeaderBrush}"
                             ContentBrush="#FFE8F5E9" Background="#FFE8F5E9"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="80">
                        <TextBlock Text="常数值" FontWeight="SemiBold"
                                   Foreground="#2E7D32" FontSize="11" />
                        <TextBlock Text="{Binding ConstantString, Mode=OneWay}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#1B5E20" Margin="0,4,0,0"/>
                        <TextBlock Margin="0,3,0,0" FontSize="9" Foreground="#4CAF50">
                            <Run Text="类型: " FontWeight="SemiBold"/>
                            <Run Text="{Binding ConstantDisplay, Mode=OneWay}" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.ConstantTemplate>

        <!-- ── 函数节点 ── -->
        <views:NodeTemplateSelector.FunctionTemplate>
            <DataTemplate DataType="{x:Type models:FunctionNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FF42A5F5" BorderThickness="1.5"
                             HeaderBrush="{StaticResource BlueHeaderBrush}"
                             ContentBrush="#FFE3F2FD" Background="#FFE3F2FD"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="100">
                        <TextBlock Text="{Binding Expression, Mode=OneWay}"
                                   FontWeight="Bold" Foreground="#1565C0"
                                   FontSize="15" FontFamily="Consolas" />
                        <TextBlock Margin="0,4,0,0" Foreground="#1565C0">
                            <Run Text="结果: " FontWeight="SemiBold" />
                            <Run Text="{Binding Output[0].Value, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.FunctionTemplate>

        <!-- ── 显示节点 ── -->
        <views:NodeTemplateSelector.DisplayTemplate>
            <DataTemplate DataType="{x:Type models:DisplayNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FF00ACC1" BorderThickness="1.5"
                             HeaderBrush="{StaticResource CyanHeaderBrush}"
                             ContentBrush="#FFE0F7FA" Background="#FFE0F7FA"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="80">
                        <TextBlock Text="观测值" FontWeight="SemiBold"
                                   Foreground="#006064" FontSize="11" />
                        <TextBlock Text="{Binding DisplayText, Mode=OneWay}"
                                   Margin="0,4,0,0" FontSize="16" FontWeight="Bold"
                                   Foreground="#00838F" />
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.DisplayTemplate>

        <!-- ── 延时节点 ── -->
        <views:NodeTemplateSelector.DelayTemplate>
            <DataTemplate DataType="{x:Type models:DelayNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FF26A69A" BorderThickness="1.5"
                             HeaderBrush="{StaticResource GreenHeaderBrush}"
                             ContentBrush="#FFE0F2F1" Background="#FFE0F2F1"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="80">
                        <TextBlock Text="延时时间" FontWeight="SemiBold"
                                   Foreground="#00695C" FontSize="11" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DelayMs, Mode=OneWay}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#004D40" HorizontalAlignment="Center"/>
                            <TextBlock Text=" ms" Grid.Column="1"
                                       Foreground="#00695C" FontSize="13"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.DelayTemplate>

        <!-- ── 判断节点 ── -->
        <views:NodeTemplateSelector.ConditionTemplate>
            <DataTemplate DataType="{x:Type models:ConditionNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FFAB47BC" BorderThickness="1.5"
                             HeaderBrush="{StaticResource PurpleHeaderBrush}"
                             ContentBrush="#FFF3E5F5" Background="#FFF3E5F5"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="100">
                        <TextBlock Text="比较方式" FontWeight="SemiBold"
                                   Foreground="#7B1FA2" FontSize="11" />
                        <TextBlock Text="{Binding CompareSymbol, Mode=OneWay}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#4A148C" Margin="0,3,0,0"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="阈值: " VerticalAlignment="Center"
                                       Foreground="#7B1FA2" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Threshold, Mode=OneWay}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#4A148C" HorizontalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.ConditionTemplate>

        <!-- ── 循环节点 ── -->
        <views:NodeTemplateSelector.LoopTemplate>
            <DataTemplate DataType="{x:Type models:LoopNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FFE53935" BorderThickness="1.5"
                             HeaderBrush="{StaticResource RedHeaderBrush}"
                             ContentBrush="#FFFFEBEE" Background="#FFFFEBEE"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="80">
                        <TextBlock Text="循环设置" FontWeight="SemiBold"
                                   Foreground="#B71C1C" FontSize="11" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LoopCount, Mode=OneWay}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#880E4F" HorizontalAlignment="Center"/>
                            <TextBlock Text=" 次" Grid.Column="1"
                                       Foreground="#B71C1C" FontSize="13"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.LoopTemplate>

        <!-- ── 图像显示节点 ── -->
        <views:NodeTemplateSelector.ImageDisplayTemplate>
            <DataTemplate DataType="{x:Type vision:ImageDisplayNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FF26C6DA" BorderThickness="1.5"
                             HeaderBrush="{StaticResource BlueHeaderBrush}"
                             ContentBrush="#FFE0F7FA" Background="#FFE0F7FA"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="8,5" MinWidth="120">
                        <Image Source="{Binding Preview.ImageSource, Mode=OneWay}"
                               Width="120" Height="90" Stretch="Uniform"
                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        <TextBlock Text="{Binding ImageInfo, Mode=OneWay}"
                                   FontSize="10" Foreground="#00838F"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.ImageDisplayTemplate>

        <!-- ── 多轴定位节点 ── -->
        <!-- ═══ 运动控制类节点通用模板（多轴定位、单轴定位等） ═══ -->
        <views:NodeTemplateSelector.MotionControlTemplate>
            <DataTemplate DataType="{x:Type motion:MultiAxisMoveNodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="#FFFFA000" BorderThickness="1.5"
                             HeaderBrush="{StaticResource HardwareHeaderBrush}"
                             ContentBrush="#FFFFF8E1" Background="#FFFFF8E1"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="130">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   Foreground="#5D4037" FontSize="11" />
                        <TextBlock Text="运动控制" FontSize="9" Foreground="#795548" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.MotionControlTemplate>

        <!-- ── 默认模板（扩展节点） ── -->
        <views:NodeTemplateSelector.DefaultTemplate>
            <DataTemplate DataType="{x:Type models:NodeViewModel}">
                <nodify:Node Header="{Binding}" HeaderTemplate="{StaticResource NodeHeaderTemplate}"
                             Input="{Binding Input}" Output="{Binding Output}"
                             BorderBrush="{Binding NodeCategoryColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1.5"
                             HeaderBrush="{Binding NodeCategoryColor, Converter={StaticResource StringToBrushConverter}}"
                             ContentBrush="#FFECEFF1" Background="#FFECEFF1"
                             Padding="0"
                             Effect="{DynamicResource NodeDropShadow}"
                             HeaderContainerStyle="{DynamicResource NodeHeaderStyle}"
                             Foreground="White">
                    <nodify:Node.InputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeInput Header="{Binding Title}"
                                             IsConnected="{Binding IsConnected}"
                                             Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                             ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                             BorderBrush="{DynamicResource ConnectorStroke}"
                                             Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.InputConnectorTemplate>
                    <nodify:Node.OutputConnectorTemplate>
                        <DataTemplate DataType="{x:Type models:ConnectorViewModel}">
                            <nodify:NodeOutput Header="{Binding Title}"
                                              IsConnected="{Binding IsConnected}"
                                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                              ConnectorTemplate="{DynamicResource CircleConnectorTemplate}"
                                              BorderBrush="{DynamicResource ConnectorStroke}"
                                              Background="{DynamicResource ConnectorFill}" />
                        </DataTemplate>
                    </nodify:Node.OutputConnectorTemplate>
                    <StackPanel Orientation="Vertical" Margin="10,6" MinWidth="100">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#455A64"/>
                        <TextBlock Text="扩展节点" FontSize="10" Foreground="#78909C" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ExecutionTimeDisplay, Mode=OneWay}"
                                   FontSize="9" Foreground="#999999" Margin="0,3,0,0"/>
                    </StackPanel>
                </nodify:Node>
            </DataTemplate>
        </views:NodeTemplateSelector.DefaultTemplate>

    </views:NodeTemplateSelector>

</ResourceDictionary>
