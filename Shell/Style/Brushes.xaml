<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 全局基础笔刷 ═══ -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ContrastBackgroundBrush" Color="#2D2D30"/>

    <!-- ═══ 工具箱文本笔刷 ═══ -->
    <SolidColorBrush x:Key="ToolboxItemForeground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ToolboxItemDescForeground" Color="#808080"/>
    <SolidColorBrush x:Key="ToolboxHeaderForeground" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ToolboxSeparatorBrush" Color="#333337"/>

    <!-- ═══ 编辑器工具栏边框 ═══ -->
    <SolidColorBrush x:Key="EditorToolbarBorder" Color="#FF3E3E42"/>

    <!-- ═══ 网格线 ═══ -->
    <SolidColorBrush x:Key="EditorGridLinesBrush" Color="#3A3A3A" />

    <GeometryDrawing x:Key="SmallGridGeometry"
                     Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z"
                     Brush="{DynamicResource EditorGridLinesBrush}" />

    <GeometryDrawing x:Key="LargeGridGeometry"
                     Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z"
                     Brush="{DynamicResource EditorGridLinesBrush}" />

    <DrawingBrush x:Key="SmallGridDrawingBrush"
                  TileMode="Tile" ViewportUnits="Absolute"
                  Viewport="0 0 20 20"
                  Drawing="{StaticResource SmallGridGeometry}" />

    <DrawingBrush x:Key="LargeGridDrawingBrush"
                  TileMode="Tile" ViewportUnits="Absolute" Opacity="0.5"
                  Viewport="0 0 200 200"
                  Drawing="{StaticResource LargeGridGeometry}" />

    <!-- ═══ 连接器 ═══ -->
    <ControlTemplate x:Key="CircleConnectorTemplate" TargetType="Control">
        <Ellipse Width="12" Height="12"
                 Stroke="{TemplateBinding BorderBrush}"
                 Fill="{TemplateBinding Background}"
                 StrokeThickness="2" />
    </ControlTemplate>
    <SolidColorBrush x:Key="ConnectorStroke" Color="#667788"/>
    <SolidColorBrush x:Key="ConnectorFill" Color="#2D2D30"/>

    <!-- ═══ 节点头部渐变色 ═══ -->
    <LinearGradientBrush x:Key="GreenHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF66BB6A" Offset="0"/>
        <GradientStop Color="#FF43A047" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF42A5F5" Offset="0"/>
        <GradientStop Color="#FF1E88E5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrangeHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFA726" Offset="0"/>
        <GradientStop Color="#FFFB8C00" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PurpleHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFAB47BC" Offset="0"/>
        <GradientStop Color="#FF8E24AA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RedHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFEF5350" Offset="0"/>
        <GradientStop Color="#FFE53935" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HardwareHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFC107" Offset="0"/>
        <GradientStop Color="#FFFFA000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CyanHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF26C6DA" Offset="0"/>
        <GradientStop Color="#FF00ACC1" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ 节点头部 Border ═══ -->
    <Style x:Key="NodeHeaderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4 4 0 0"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <!-- ═══ 节点阴影 ═══ -->
    <DropShadowEffect x:Key="NodeDropShadow"
                      BlurRadius="6" ShadowDepth="1.5"
                      Opacity="0.35" Color="#000000"/>

    <!-- ═══ 日志 / 图像预览面板笔刷（深色） ═══ -->
    <SolidColorBrush x:Key="LogPanelBackgroundBrush" Color="#12121E"/>
    <SolidColorBrush x:Key="LogPanelTextBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="LogPanelBorderBrush" Color="#3F3F58"/>
    <SolidColorBrush x:Key="ImagePanelInfoBrush" Color="#1E1E2E"/>

    <!-- ═══ 工具箱交互笔刷（深色） ═══ -->
    <SolidColorBrush x:Key="ToolboxItemHoverBrush" Color="#3A3A4A"/>
    <SolidColorBrush x:Key="ToolboxItemSelectedBrush" Color="#1E5A8A"/>

    <!-- ═══ 工具箱卡片笔刷（深色） ═══ -->
    <SolidColorBrush x:Key="ToolboxCardBackgroundBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ToolboxCardBorderBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ToolboxSearchFocusBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="ToolboxBadgeBrush" Color="#FF4A4A5A"/>

    <!-- ═══ 变量管理器面板笔刷 ═══ -->
    <SolidColorBrush x:Key="VarPanelBackgroundBrush" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="VarPanelTextBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="VarPanelBorderBrush" Color="#3F3F58"/>
    <SolidColorBrush x:Key="VarPanelInputBgBrush" Color="#2D2D30"/>

    <!-- ═══ 节点编辑弹窗笔刷 ═══ -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF1C1C28"/>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#FF252535"/>
    <SolidColorBrush x:Key="DialogTitleTextBrush" Color="#C0C0D0"/>
    <SolidColorBrush x:Key="DialogFooterBrush" Color="#FF222233"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#FF3F3F58"/>
    <SolidColorBrush x:Key="EditorCardBrush" Color="#FF1E1E2E"/>
    <!-- 卡片行背景（ItemsControl 内各行） -->
    <SolidColorBrush x:Key="CardRowBrush" Color="#FF252535"/>
    <!-- 编辑控件通用暗底 -->
    <SolidColorBrush x:Key="EditControlBgBrush" Color="#FF2A2A3C"/>
    <SolidColorBrush x:Key="EditControlBorderBrush" Color="#FF3F3F58"/>
    <!-- 辅助文字 -->
    <SolidColorBrush x:Key="HintTextBrush" Color="#78909C"/>
    <SolidColorBrush x:Key="SectionTextBrush" Color="#90A4AE"/>

</ResourceDictionary>
