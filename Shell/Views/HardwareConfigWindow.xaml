<Window x:Class="Shell.Views.HardwareConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Core.UI.Controls;assembly=Core.UI"
        Title="⚙ 硬件配置" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinHeight="450" MinWidth="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- ═══ 深色 DataGrid 统一样式 ═══ -->
        <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Background" Value="#FF2A2A3C"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF3F3F58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FF2A2A3C"/>
            <Setter Property="AlternatingRowBackground" Value="#FF2F2F42"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FF3F3F58"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#FF2E2E40"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#D0D0D0"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF1A3A5C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#FF42A5F5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF333350"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF1F1F32"/>
                        <Setter Property="Foreground" Value="#90A4AE"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="BorderBrush" Value="#FF3F3F58"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FF2A2A44"/>
                                            <Setter Property="Foreground" Value="#B0BEC5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#FF2A2A3C"/>
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF333350"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF1A3A5C"/>
                            </Trigger>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#FF2F2F42"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 居中的只读 TextBlock 样式 -->
        <Style x:Key="CellCenterStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 居左的文本样式（名称列） -->
        <Style x:Key="CellLeftStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ 编辑态样式：解决双击后样式突变问题 ═══ -->

        <!-- 编辑态 TextBox 样式（字符串列） -->
        <Style x:Key="DarkTextEditStyle" TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF2A2A3C"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF42A5F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 编辑态 NumericTextBox 样式（数值列） -->
        <Style x:Key="DarkNumericEditStyle" TargetType="{x:Type ctrl:NumericTextBox}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF2A2A3C"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF42A5F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="EnableKeypad" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DialogBackgroundBrush}" CornerRadius="8"
            BorderBrush="#FF3F3F58" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#FF252535" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⚙ 硬件参数配置" VerticalAlignment="Center" Margin="16,0"
                               FontSize="14" FontWeight="SemiBold" Foreground="#C0C0D0"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Click="CancelButton_Click"
                            Style="{StaticResource DialogCloseBtn}"/>
                </Grid>
            </Border>

            <!-- Tab 页 -->
            <TabControl Grid.Row="1" Background="#FF1C1C28" BorderThickness="0"
                        Padding="0" Margin="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Foreground" Value="#AAA"/>
                        <Setter Property="Background" Value="#FF252535"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="18,9"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF1C1C28"/>
                                            <Setter Property="Foreground" Value="#42A5F5"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#DDD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- ═══ 轴参数 ═══ -->
                <TabItem Header="📐 轴参数">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="轴运动参数配置" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#B0B8C0" VerticalAlignment="Center"/>
                            <Button Content="＋ 添加轴" HorizontalAlignment="Right" Width="84" Height="28"
                                    FontSize="11.5" Background="#FF2E7D32" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                    Command="{Binding AddAxisCommand}"/>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Axes}"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  AlternatingRowBackground="#FF2F2F42">
                            <DataGrid.Columns>
                                <!-- RegID -->
                                <DataGridTextColumn Header="RegID" Width="60"
                                                    Binding="{Binding RegID}" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellCenterStyle}"/>
                                <!-- 名称 (自动填充剩余宽度) -->
                                <DataGridTextColumn Header="名称" Width="*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellCenterStyle}"
                                                    EditingElementStyle="{StaticResource DarkTextEditStyle}"/>
                                <!-- 卡号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="卡号" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CardID}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding CardID, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 轴号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="轴号" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AxisID}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding AxisID, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 加速时间 (double → Float) -->
                                <DataGridTemplateColumn Header="加速时间 (s)" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccTime}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding AccTime, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Float" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 启动速度 (double → Float) -->
                                <DataGridTemplateColumn Header="启动速度" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartSpeed}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding StartSpeed, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Float" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 复位速度 (double → Float) -->
                                <DataGridTemplateColumn Header="复位速度" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HomeSpeed}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding HomeSpeed, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Float" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 脉冲当量 (double → Float) -->
                                <DataGridTemplateColumn Header="脉冲当量" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Equiv}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Equiv, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Float" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 操作 -->
                                <DataGridTemplateColumn Header="" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Width="28" Height="24"
                                                    Background="Transparent" Foreground="#EF5350"
                                                    BorderThickness="0" Cursor="Hand" FontSize="13"
                                                    Command="{Binding DataContext.RemoveAxisCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ═══ 输入信号 ═══ -->
                <TabItem Header="📥 输入信号">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="输入 IO 信号配置" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#B0B8C0" VerticalAlignment="Center"/>
                            <Button Content="＋ 添加输入" HorizontalAlignment="Right" Width="84" Height="28"
                                    FontSize="11.5" Background="#FF2E7D32" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                    Command="{Binding AddInputCommand}"/>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Inputs}"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  AlternatingRowBackground="#FF2F2F42">
                            <DataGrid.Columns>
                                <!-- RegID -->
                                <DataGridTextColumn Header="RegID" Width="60"
                                                    Binding="{Binding RegID}" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellCenterStyle}"/>
                                <!-- 名称 (自动填充剩余宽度) -->
                                <DataGridTextColumn Header="名称" Width="*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellCenterStyle}"
                                                    EditingElementStyle="{StaticResource DarkTextEditStyle}"/>
                                <!-- 卡号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="卡号" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cardno}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Cardno, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 节点号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="节点号" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nodeno}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Nodeno, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 位号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="位号" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Bitno}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Bitno, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 操作 -->
                                <DataGridTemplateColumn Header="" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Width="28" Height="24"
                                                    Background="Transparent" Foreground="#EF5350"
                                                    BorderThickness="0" Cursor="Hand" FontSize="13"
                                                    Command="{Binding DataContext.RemoveInputCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ═══ 输出信号 ═══ -->
                <TabItem Header="📤 输出信号">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="输出 IO 信号配置" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#B0B8C0" VerticalAlignment="Center"/>
                            <Button Content="＋ 添加输出" HorizontalAlignment="Right" Width="84" Height="28"
                                    FontSize="11.5" Background="#FF2E7D32" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                    Command="{Binding AddOutputCommand}"/>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Outputs}"
                                  Style="{StaticResource DarkDataGridStyle}"
                                  AlternatingRowBackground="#FF2F2F42">
                            <DataGrid.Columns>
                                <!-- RegID -->
                                <DataGridTextColumn Header="RegID" Width="60"
                                                    Binding="{Binding RegID}" IsReadOnly="True"
                                                    ElementStyle="{StaticResource CellCenterStyle}"/>
                                <!-- 名称 (自动填充剩余宽度) -->
                                <DataGridTextColumn Header="名称" Width="*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellCenterStyle}"
                                                    EditingElementStyle="{StaticResource DarkTextEditStyle}"/>
                                <!-- 卡号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="卡号" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cardno}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Cardno, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 节点号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="节点号" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Nodeno}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Nodeno, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 位号 (ushort → Int) -->
                                <DataGridTemplateColumn Header="位号" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Bitno}" Style="{StaticResource CellCenterStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ctrl:NumericTextBox Text="{Binding Bitno, UpdateSourceTrigger=LostFocus}"
                                                                 NumberKind="Int" Style="{StaticResource DarkNumericEditStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- 操作 -->
                                <DataGridTemplateColumn Header="" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Width="28" Height="24"
                                                    Background="Transparent" Foreground="#EF5350"
                                                    BorderThickness="0" Cursor="Hand" FontSize="13"
                                                    Command="{Binding DataContext.RemoveOutputCommand,
                                                              RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Background="#FF222233" CornerRadius="0,0,8,8" Padding="18,14">
                <Grid>
                    <TextBlock Text="{Binding CardVersionDisplay}" 
                               FontSize="11" Foreground="#607D8B"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取 消" Margin="0,0,14,0" Click="CancelButton_Click"
                                Style="{StaticResource DialogCancelBtn}"/>
                        <Button Content="✓ 确 定" Click="ConfirmButton_Click"
                                Style="{StaticResource DialogConfirmBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
