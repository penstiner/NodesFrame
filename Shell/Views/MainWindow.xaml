<Window x:Class="Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shell.Views"
        xmlns:views="clr-namespace:Shell.Views"
        xmlns:models="clr-namespace:Shell.Models"
        xmlns:viewModels="clr-namespace:Shell.ViewModels"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:nodify="clr-namespace:Nodify;assembly=Nodify" 
        xmlns:prism="http://prismlibrary.com/"
        xmlns:shared="clr-namespace:Nodify;assembly=Nodify.Shared"
        xmlns:ctrl="clr-namespace:Core.UI.Controls;assembly=Core.UI"
        mc:Ignorable="d"
        prism:ViewModelLocator.AutoWireViewModel="True"
        WindowStartupLocation="CenterScreen"
        Title="流程编辑器" Height="1000" Width="1700"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="1" 
                      NonClientFrameEdges="None"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <shared:BindingProxy x:Key="EditorProxy" DataContext="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:StringToBrushConverter x:Key="StringToBrushConverter" />
        <shared:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <shared:FontFamilyKeyConverter x:Key="FontFamilyKeyConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Background="{DynamicResource ContrastBackgroundBrush}" Padding="6,0">
            <Grid>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                       Margin="15,0" Foreground="{DynamicResource ToolboxItemForeground}">
                <Run Text="&#xf085;" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource ToolboxItemForeground}"
                     FontFamily="{StaticResource FontAwesome}"/>
                <Run Text=" 流程编辑器" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource ToolboxItemForeground}"/>
                <Run Text="  .NET8" FontSize="12" Foreground="{DynamicResource ToolboxItemDescForeground}"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button Content="&#xf068;" FontFamily="{StaticResource FontAwesome}" FontSize="10"
                        Foreground="{DynamicResource ToolboxItemDescForeground}" 
                        Style="{StaticResource WindowsButtonStyle}" Click="ButtonMin_Click"/>
                <Button Content="&#xf2d0;" FontFamily="{StaticResource FontAwesome}" FontSize="10"
                        Foreground="{DynamicResource ToolboxItemDescForeground}" 
                        Style="{StaticResource WindowsButtonStyle}" Click="ButtonMax_Click"/>
                <Button Content="&#xf00d;" FontFamily="{StaticResource FontAwesome}" FontSize="11"
                        Foreground="{DynamicResource ToolboxItemDescForeground}" 
                        Style="{StaticResource WindowsButtonStyle}" Click="Button_Click"/>
            </StackPanel>
            </Grid>
        </Border>

        <!-- 左侧工具箱（可折叠） -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                </Grid.ColumnDefinitions>

                <!-- 工具箱主体 -->
                <Grid Grid.Column="0" x:Name="ToolboxContent" Width="200" ClipToBounds="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=ToolBoxToggle}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 To="200" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <!-- 标题栏 + 折叠按钮 -->
                    <Border Grid.Row="0" Background="{DynamicResource ContrastBackgroundBrush}" Padding="8,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource ToolboxItemForeground}" FontSize="14" FontWeight="SemiBold">
                                <Run Text="&#xf0b0;" FontFamily="{StaticResource FontAwesome}" FontSize="13"/>
                                <Run Text=" 工具箱"/>
                            </TextBlock>
                            <ToggleButton Grid.Column="1" x:Name="ToolBoxToggle"
                                          FontFamily="{StaticResource FontAwesome}"
                                          Content="&#xf053;" FontSize="10" Foreground="#666"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand"
                                          ToolTip="折叠工具箱"
                                          VerticalAlignment="Center" Padding="5,3" IsChecked="True">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                                            <Setter Property="Foreground" Value="#BBB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                    </Border>
                    <!-- ═══ 搜索框 ═══ -->
                    <Border Grid.Row="1" x:Name="SearchBorder"
                            CornerRadius="8" Background="{DynamicResource ContrastBackgroundBrush}"
                            BorderBrush="{DynamicResource ToolboxCardBorderBrush}" BorderThickness="1"
                            Margin="8,8,8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ToolboxSearchFocusBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 搜索图标 -->
                            <TextBlock Grid.Column="0" Text="&#xf002;" FontFamily="{StaticResource FontAwesome}"
                                       FontSize="12" Foreground="#60FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <!-- 搜索输入框 -->
                            <hc:TextBox Grid.Column="0" Grid.ColumnSpan="3"
                                     hc:InfoElement.Placeholder="搜索节点..."
                                     Text="{Binding ToolBox.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="28,6,28,6"
                                     Foreground="{DynamicResource ToolboxItemForeground}"
                                     CaretBrush="{DynamicResource ToolboxItemForeground}"
                                     VerticalContentAlignment="Center" FontSize="12"/>
                            <!-- 清除按钮 -->
                            <Button Grid.Column="2" Content="&#xf00d;" FontFamily="{StaticResource FontAwesome}"
                                    FontSize="10" Foreground="#60FFFFFF" Background="Transparent" BorderThickness="0"
                                    Command="{Binding ToolBox.ClearSearchCommand}" Cursor="Hand"
                                    Margin="0,0,8,0" Padding="4" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToolBox.SearchText, Converter={StaticResource StringToVisibilityConverter}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- ═══ TreeView + 右侧分隔线 ═══ -->
                    <Grid Grid.Row="2">
                        <TreeView x:Name="ToolBoxTree" Background="{DynamicResource BackgroundBrush}"
                                 BorderThickness="0" Padding="0,8" Margin="0,0,1,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding ToolBox.Categories}">
                            <TreeView.Resources>
                                <!-- 叶节点样式：移除展开按钮和缩进 -->
                                <Style x:Key="LeafItemStyle" TargetType="TreeViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ToolBoxTree_PreviewMouseLeftButtonDown"/>
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ToolBoxTree_PreviewMouseLeftButtonUp"/>
                                    <EventSetter Event="PreviewMouseMove" Handler="ToolBoxTree_PreviewMouseMove"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter ContentSource="Header"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <!-- ═══ 分类标题模板 ═══ -->
                                <HierarchicalDataTemplate DataType="{x:Type models:ToolBoxCategory}" ItemsSource="{Binding Items}"
                                                         ItemContainerStyle="{StaticResource LeafItemStyle}">
                                    <Border Background="#10FFFFFF" CornerRadius="4" Padding="4,6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 分类名 -->
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource ToolboxHeaderForeground}" VerticalAlignment="Center"/>
                                    <!-- 计数徽章 -->
                                    <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource ToolboxBadgeBrush}"
                                            Padding="6,2" Margin="8,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Items.Count}" FontSize="10" Foreground="#AAA"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                        <!-- ═══ 节点项卡片模板 ═══ -->
                        <DataTemplate DataType="{x:Type models:ToolBoxItem}">
                            <Border x:Name="CardBd" CornerRadius="6" Margin="2,2,6,2" Padding="0"
                                    Background="{DynamicResource ToolboxCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource ToolboxCardBorderBrush}" BorderThickness="1"
                                    Cursor="Hand">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"
                                                       Margin="0,4,0,0" Foreground="#AAAAAA"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ToolboxItemHoverBrush}"/>
                                                <Setter Property="BorderBrush" Value="#30FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 左侧色条 -->
                                    <Border Grid.Column="0" CornerRadius="3,0,0,3">
                                        <Border.Background>
                                            <Binding Path="ColorTag" Converter="{StaticResource StringToBrushConverter}"/>
                                        </Border.Background>
                                    </Border>
                                    <!-- 图标区 -->
                                    <TextBlock Grid.Column="1" Text="{Binding IconCode}"
                                               FontFamily="{Binding IconFontFamily, Converter={StaticResource FontFamilyKeyConverter}}" FontSize="14"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="10,0,6,0" Width="20">
                                        <TextBlock.Foreground>
                                            <Binding Path="ColorTag" Converter="{StaticResource StringToBrushConverter}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <!-- 文字区 -->
                                    <TextBlock Grid.Column="2" Margin="4,6,8,6" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ToolboxItemForeground}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource ToolboxItemForeground}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ToolBoxTree_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ToolBoxTree_PreviewMouseLeftButtonUp"/>
                            <EventSetter Event="PreviewMouseMove" Handler="ToolBoxTree_PreviewMouseMove"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border Name="HeaderBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Name="Expander" Grid.Column="0"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                  Width="14" Height="14" Margin="2,0,4,0" ClickMode="Press">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="Transparent" Width="14" Height="14">
                                                                    <TextBlock Name="Arrow" Text="&#xf054;" FontFamily="{StaticResource FontAwesome}"
                                                                               Foreground="#888" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               RenderTransformOrigin="0.5,0.5">
                                                                        <TextBlock.RenderTransform>
                                                                            <RotateTransform Angle="0"/>
                                                                        </TextBlock.RenderTransform>
                                                                    </TextBlock>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Arrow" Property="Text" Value="&#xf078;"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Arrow" Property="Foreground" Value="#CCC"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="0,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter Name="ItemsHost" Margin="4,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
                <!-- 右侧分隔线 -->
                <Border Width="1" Background="{DynamicResource ToolboxSeparatorBrush}"
                        HorizontalAlignment="Right" Margin="0,0,0,0"/>
            </Grid>
        </Grid>
        <!-- 折叠边栏（始终可见） -->
        <Border Grid.Column="1" Width="28" Background="{DynamicResource ContrastBackgroundBrush}"
                BorderBrush="{DynamicResource ToolboxSeparatorBrush}" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ToolboxItemHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ToggleButton FontFamily="{StaticResource FontAwesome}"
                         Content="&#xf054;" FontSize="10" Foreground="#666"
                         Background="Transparent" BorderThickness="0" Cursor="Hand"
                         IsChecked="{Binding IsChecked, ElementName=ToolBoxToggle, Mode=TwoWay}"
                         VerticalAlignment="Center" HorizontalAlignment="Center">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"
                                            Width="22" Height="22"
                                            Padding="0">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                                            <Setter Property="Foreground" Value="#BBB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Content" Value="&#xf053;"/>
                                <Setter Property="ToolTip" Value="折叠工具箱"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                <Setter Property="Content" Value="&#xf054;"/>
                                <Setter Property="ToolTip" Value="展开工具箱"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
        </Border>
        </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" x:Name="EditorGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ContrastBackgroundBrush}" Padding="4,3"
                    BorderBrush="{DynamicResource EditorToolbarBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 撤销/重做组 -->
                <Button ToolTip="撤销 (Ctrl+Z)" Command="{Binding UndoCommand}"
                        Style="{StaticResource IconBtnStyle}">&#xf0e2;</Button>
                <Button ToolTip="重做 (Ctrl+Y)" Command="{Binding RedoCommand}"
                        Style="{StaticResource IconBtnStyle}">&#xf01e;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <!-- 缩放控制组 -->
                <Button ToolTip="适应屏幕" Command="nodify:EditorCommands.FitToScreen"
                        CommandTarget="{Binding ElementName=Editor}"
                        Style="{StaticResource IconBtnStyle}">&#xf065;</Button>
                <Button ToolTip="缩小" Command="nodify:EditorCommands.ZoomOut"
                        CommandTarget="{Binding ElementName=Editor}"
                        Style="{StaticResource IconBtnStyle}">&#xf068;</Button>
                <Button ToolTip="放大" Command="nodify:EditorCommands.ZoomIn"
                        CommandTarget="{Binding ElementName=Editor}"
                        Style="{StaticResource IconBtnStyle}">&#xf067;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <!-- 文件操作组 -->
                <Button ToolTip="保存 (直接覆写)" Command="{Binding SaveCommand}"
                        Style="{StaticResource IconBtnAccentStyle}">&#xf0c7;</Button>
                <Button ToolTip="另存为" Command="{Binding SaveAsCommand}"
                        Style="{StaticResource IconBtnAccentStyle}">&#xf0c5;</Button>
                <Button ToolTip="加载" Command="{Binding LoadCommand}"
                        Style="{StaticResource IconBtnAccentStyle}">&#xf07b;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <!-- 危险操作 -->
                <Button ToolTip="清空" Command="{Binding ClearCommand}"
                        Style="{StaticResource IconBtnDangerStyle}">&#xf1f8;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <!-- 硬件 -->
                <Button ToolTip="硬件配置（轴参数 / IO 信号）" Command="{Binding HardwareConfigCommand}"
                        Style="{StaticResource IconBtnWarnStyle}">&#xf085;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <!-- 布局 -->
                <Button ToolTip="自动布局" Command="{Binding AutoLayoutCommand}"
                        Style="{StaticResource IconBtnPurpleStyle}">&#xf0e8;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <!-- 执行组（增强视觉权重） -->
                <Button Command="{Binding ExecuteCommand}"
                        Style="{StaticResource SuccessAccentBtnStyle}" Height="30" Padding="12,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xf04b;" FontFamily="{StaticResource FontAwesome}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="执行" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button ToolTip="停止流程" Command="{Binding StopCommand}" IsEnabled="True"
                        Style="{StaticResource IconBtnDangerStyle}">&#xf04d;</Button>
                <Rectangle Width="1" Height="18" Fill="#40FFFFFF" Margin="6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ExecutionError}" Foreground="Red" VerticalAlignment="Center" 
                           Margin="10,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            </Border>

            <nodify:NodifyEditor Grid.Row="1" GridCellSize="20"
                                 ItemsSource="{Binding Nodes}" Connections="{Binding Connections}"
                                 SelectedItems="{Binding SelectedNodes}" PendingConnection="{Binding PendingConnection}"
                                 DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                 RemoveConnectionCommand="{Binding DeleteConnectionCommand}"
                                 Margin="10" x:Name="Editor"
                                 AllowDrop="True" DragOver="Editor_DragOver" Drop="Editor_Drop"
                                 Background="{StaticResource SmallGridDrawingBrush}">
                <nodify:NodifyEditor.ItemTemplateSelector>
                    <StaticResource ResourceKey="NodeTemplateSelector" />
                </nodify:NodifyEditor.ItemTemplateSelector>
                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location" Value="{Binding Location}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <EventSetter Event="MouseDoubleClick" Handler="ItemContainer_MouseDoubleClick" />
                        <Style.Triggers>
                            <!-- 执行中：蓝色呼吸辉光（边框脉冲，无 DropShadow 避免软件渲染） -->
                            <DataTrigger Binding="{Binding State}" Value="Running">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="BreathAnim">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                             From="2" To="6" Duration="0:0:0.6"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.85" To="1.0" Duration="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BreathAnim"/>
                                </DataTrigger.ExitActions>
                                <Setter Property="BorderBrush" Value="#FF42A5F5"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </DataTrigger>
                            <!-- 错误：红色呼吸辉光 -->
                            <DataTrigger Binding="{Binding State}" Value="Error">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="ErrorBreathAnim">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ThicknessAnimation Storyboard.TargetProperty="BorderThickness"
                                                             From="2" To="6" Duration="0:0:0.8"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.85" To="1.0" Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ErrorBreathAnim"/>
                                </DataTrigger.ExitActions>
                                <Setter Property="BorderBrush" Value="#FFEF5350"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </DataTrigger>
                            <!-- 选中状态（最后，优先级最高） -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#FF7C4DFF" />
                                <Setter Property="Panel.ZIndex" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>
                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type viewModels:PendingConnectionViewModel}">
                        <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                  CompletedCommand="{Binding FinishCommand}"
                                                  AllowOnlyConnectors="True" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type models:ConnectionViewModel}">
                        <nodify:LineConnection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"
                                               Cursor="Hand" OutlineThickness="5"
                                               MouseLeftButtonDown="Connection_MouseLeftButtonDown"
                                               Style="{StaticResource ConnectionLineStyle}">
                            <nodify:LineConnection.ContextMenu>
                                <ContextMenu DataContext="{Binding DataContext, Source={StaticResource EditorProxy}}"
                                             Background="{DynamicResource ContrastBackgroundBrush}"
                                             BorderBrush="#FF3F3F46" BorderThickness="1" Foreground="#D4D4D4" Padding="2">
                                    <ContextMenu.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                                    </ContextMenu.Effect>
                                    <MenuItem Command="{Binding DeleteConnectionCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              Style="{StaticResource ConnectionMenuItemStyle}" />
                                </ContextMenu>
                            </nodify:LineConnection.ContextMenu>
                        </nodify:LineConnection>
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>
            </nodify:NodifyEditor>

            <nodify:Minimap Grid.Row="1"
                            ItemsSource="{Binding ItemsSource, ElementName=Editor}"
                            ViewportLocation="{Binding ViewportLocation, ElementName=Editor}"
                            ViewportSize="{Binding ViewportSize, ElementName=Editor}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Width="160" Height="110" Margin="15" Panel.ZIndex="100"
                            Background="#99252526">
                <nodify:Minimap.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:MinimapItem}" BasedOn="{StaticResource {x:Type nodify:MinimapItem}}">
                        <Setter Property="Location" Value="{Binding Location}" />
                        <Setter Property="Width" Value="60" />
                        <Setter Property="Height" Value="40" />
                    </Style>
                </nodify:Minimap.ItemContainerStyle>
            </nodify:Minimap>

            <!-- ═══ 日志面板（编辑器内部下方） ═══ -->
            <Border Grid.Row="2" Background="{DynamicResource LogPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource LogPanelBorderBrush}" BorderThickness="0,1,0,0">
                <Border.ContextMenu>
                    <ContextMenu Background="{DynamicResource ContrastBackgroundBrush}"
                                 BorderBrush="#FF3F3F46" BorderThickness="1"
                                 Foreground="{DynamicResource ToolboxItemForeground}" Padding="2">
                        <MenuItem Header="&#xf12d;  清空日志" FontFamily="{StaticResource FontAwesome}"
                                  FontSize="12" Click="ClearLog_Click" Padding="10,6"/>
                        <Separator/>
                        <MenuItem x:Name="MenuCollapseItem" FontSize="12" Padding="10,6"
                                  Click="LogCollapse_Click">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MenuCollapseIcon" Text="&#xf078;"
                                               FontFamily="{StaticResource FontAwesome}" FontSize="11"/>
                                    <TextBlock x:Name="MenuCollapseText" Text="  折叠日志" Margin="0,0,0,0"/>
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ContrastBackgroundBrush}" Padding="10,5">
                        <Grid>
                            <TextBlock Foreground="{DynamicResource ToolboxItemForeground}"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="&#xf0ca;" FontFamily="{StaticResource FontAwesome}" FontSize="12"/>
                                <Run Text=" 执行日志"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Width="52" Height="22"
                                        Click="ClearLog_Click"
                                        Background="{DynamicResource ToolboxCardBackgroundBrush}" 
                                        Foreground="{DynamicResource ToolboxItemForeground}"
                                        BorderBrush="{DynamicResource ToolboxCardBorderBrush}" BorderThickness="1" 
                                        Cursor="Hand" ToolTip="清空日志">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="6,2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#25FFFFFF"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#35FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xf2ed;" FontFamily="{StaticResource FontAwesome}" FontSize="9"
                                                   Foreground="{DynamicResource ToolboxItemDescForeground}" Margin="0,0,4,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="清空" FontSize="10" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="LogCollapseBtn" Width="28" Height="26"
                                        Click="LogCollapse_Click"
                                        Background="Transparent"
                                        Foreground="{DynamicResource ToolboxItemForeground}"
                                        BorderThickness="0" Cursor="Hand"
                                        ToolTip="折叠/展开日志"
                                        FontFamily="{StaticResource FontAwesome}" FontSize="14">&#xf077;</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <hc:ScrollViewer Grid.Row="1" Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="LogItemsControl"
                                      Background="{DynamicResource BackgroundBrush}" Margin="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 颜色标记条 -->
                                            <Border x:Name="LevelBar" Grid.Column="0" Background="#FF42A5F5" CornerRadius="1"/>
                                            <!-- 日志文本 -->
                                            <TextBlock x:Name="LogTextBlock" Grid.Column="1" Text="{Binding DisplayText}" FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI" FontSize="11.5"
                                                       Foreground="#FF42A5F5"
                                                       Margin="8,3,6,3" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="LevelBar" Property="Background" Value="#FFFFA726"/>
                                            <Setter TargetName="LogTextBlock" Property="Foreground" Value="#FFFFA726"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter TargetName="LevelBar" Property="Background" Value="#FFEF5350"/>
                                            <Setter TargetName="LogTextBlock" Property="Foreground" Value="#FFEF5350"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Success">
                                            <Setter TargetName="LevelBar" Property="Background" Value="#FF66BB6A"/>
                                            <Setter TargetName="LogTextBlock" Property="Foreground" Value="#FF66BB6A"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </hc:ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 右侧面板（图像预览 + 变量管理器）═══ -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 图像预览 -->
            <Border Grid.Row="0" Background="{DynamicResource LogPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource LogPanelBorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ContrastBackgroundBrush}" Padding="10,8">
                        <Grid>
                            <TextBlock Foreground="{DynamicResource ToolboxItemForeground}"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="&#xf03e;" FontFamily="{StaticResource FontAwesome}" FontSize="13"/>
                                <Run Text=" 图像预览"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button ToolTip="重置缩放 (100%)" Style="{StaticResource IconBtnStyle}"
                                        Click="ImageFit_Click" FontSize="12" Margin="0,0,4,0">&#xf065;</Button>
                                <Button ToolTip="缩小" Style="{StaticResource IconBtnStyle}"
                                        Click="ImageZoomOut_Click" FontSize="12">&#xf068;</Button>
                                <Button ToolTip="放大" Style="{StaticResource IconBtnStyle}"
                                        Click="ImageZoomIn_Click" FontSize="12">&#xf067;</Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- 单图 / 双图对比 -->
                    <Grid Grid.Row="1" Margin="3">
                        <ctrl:ImageViewer x:Name="PreviewViewer"
                                          Source="{Binding SelectedPreviewImage, Mode=OneWay}"
                                          Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"/>
                        <Grid Visibility="{Binding IsCompareMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ctrl:ImageViewer Grid.Row="0"
                                              Source="{Binding SelectedPreviewImage, Mode=OneWay}"/>
                            <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ToolboxSeparatorBrush}" ResizeBehavior="PreviousAndNext"/>
                            <ctrl:ImageViewer Grid.Row="2"
                                              Source="{Binding SecondPreviewImage, Mode=OneWay}"/>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Padding="8,4"
                            Background="{DynamicResource ImagePanelInfoBrush}">
                        <Grid>
                            <TextBlock Text="{Binding SelectedImageInfo, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ToolboxItemDescForeground}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"/>
                            <!-- 缩放百分比 -->
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{DynamicResource ToolboxItemDescForeground}"
                                       Text="{Binding ElementName=PreviewViewer, Path=Scale, StringFormat={}{0:P0}}"
                                       Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Visible}"/>
                            <StackPanel Visibility="{Binding IsCompareMode, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding SelectedImageInfo, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{DynamicResource ToolboxItemDescForeground}"
                                           TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SecondImageInfo, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{DynamicResource ToolboxItemDescForeground}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                          Background="{DynamicResource ToolboxSeparatorBrush}" ResizeBehavior="PreviousAndNext"/>

            <!-- 变量管理器 -->
            <Border Grid.Row="2" Background="{DynamicResource LogPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource LogPanelBorderBrush}" BorderThickness="1,0,0,0">
                <views:VariableManagerPanel DataContext="{Binding}" />
            </Border>
        </Grid>

        <!-- ═══ Growl 通知宿主（居中显示）═══ -->
        <StackPanel x:Name="GrowlHost" Grid.RowSpan="2" Grid.ColumnSpan="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" />
    </Grid>
</Window>
